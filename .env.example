PICKEM_EMAIL=
PICKEM_PASSWORD=

# Storage: local (default) or s3. S3 mode needs the bucket, and outside Lambda an AWS region.
# PICKEM_STORAGE=s3
# PICKEM_BUCKET=
# AWS_DEFAULT_REGION=
# AWS_PROFILE=
# scripts/upload-pickem-auth.sh also reads AWS_DEFAULT_REGION (e.g. us-east-2) and AWS_PROFILE.
# AWS_PROFILE is just the profile name as listed by `aws configure list-profiles`, with no
# "profile " prefix: AWS_PROFILE=my-profile. Both are optional; unset uses your AWS CLI defaults.
